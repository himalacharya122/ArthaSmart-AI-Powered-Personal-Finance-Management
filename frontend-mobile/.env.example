# ArthaSmart Mobile — Environment Variables
# Copy this file to .env and fill in your values.
# Expo SDK 54 auto-loads EXPO_PUBLIC_* vars via @expo/env

# OCR Service (get free key at https://ocr.space/ocrapi)
EXPO_PUBLIC_OCR_SPACE_API_KEY=your_ocr_space_api_key_here

# Future: Google Cloud Vision
# EXPO_PUBLIC_GOOGLE_VISION_API_KEY=

# Google OAuth Client IDs (create at console.cloud.google.com)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id_here
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id_here
