# Mobile app environment variables
# Copy this file to .env and fill in your values.
# Expo SDK 54 auto-loads EXPO_PUBLIC_* vars via @expo/env. They are bundled into the app, so anyone with the app can read them.

# Backend origin, without /api/v1. For Expo Go on a physical device use your machine's LAN IP, e.g. http://192.168.1.10:8000
# If unset, the Android emulator uses http://10.0.2.2:8000 and the iOS simulator uses http://localhost:8000
EXPO_PUBLIC_API_URL=

# OCR Service (get free key at https://ocr.space/ocrapi)
EXPO_PUBLIC_OCR_SPACE_API_KEY=your_ocr_space_api_key_here

# Future: Google Cloud Vision
# EXPO_PUBLIC_GOOGLE_VISION_API_KEY=

# Google OAuth Client IDs (create at console.cloud.google.com). Same values as the GOOGLE_* vars in backend/.env.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id_here
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id_here
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id_here
