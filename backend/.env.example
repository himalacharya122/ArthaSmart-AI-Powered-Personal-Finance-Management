# Backend environment variables
# Copy to backend/.env. Used by the Django API, the Celery worker/beat, and (in Docker) the Postgres container.
# The values below are for running the backend directly on your machine.
# docker-compose.yml overrides POSTGRES_HOST, REDIS_URL, CELERY_BROKER_URL and AI_SERVICE_URL with the Docker service names, so this same file works in both setups.

# Django
DJANGO_SECRET_KEY=put-a-long-random-string-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Database (PostgreSQL). Leave POSTGRES_HOST empty to use SQLite instead.
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=put-a-database-password-here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# JWT lifetimes (minutes)
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Email (Gmail SMTP). If EMAIL_HOST_USER is empty and DEBUG is on, emails are printed to the console.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# AI service
AI_SERVICE_URL=http://localhost:8001
# Shared secret between backend and AI service. Must match SERVICE_SECRET_KEY in ai-service/.env.
SERVICE_SECRET_KEY=put-a-shared-secret-here

# Google OAuth client IDs (same values as the mobile app's EXPO_PUBLIC_GOOGLE_* vars)
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# Sentry error monitoring (optional)
SENTRY_DSN=
