# ArthaSmart Backend Environment Variables

# Django
DJANGO_SECRET_KEY=put your secret key here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
POSTGRES_DB=kash_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# CORS
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Email (Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=email here
EMAIL_HOST_PASSWORD=app password here
DEFAULT_FROM_EMAIL=email here
# AI Service
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_KEY=artha-ai-service-key-change-in-production

# Sentry (Error Monitoring)
SENTRY_DSN=

# Google OAuth Client IDs
GOOGLE_ANDROID_CLIENT_ID=put your Android client ID here
GOOGLE_IOS_CLIENT_ID=put your iOS client ID here
GOOGLE_WEB_CLIENT_ID=put your Web client ID here
