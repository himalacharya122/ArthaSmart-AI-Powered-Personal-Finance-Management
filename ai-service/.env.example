# Groq Cloud (OpenAI-compatible API)
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Models
LLM_MODEL=llama-3.3-70b-versatile
LLM_MODEL_FALLBACK=llama-3.1-8b-instant
STT_MODEL=whisper-large-v3-turbo
TTS_MODEL=playai-tts
TTS_VOICE=Fritz-PlayAI

# LLM Parameters
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
MAX_CONVERSATION_HISTORY=10
MAX_MEMORY_FACTS=50

# Service-to-service auth
SERVICE_SECRET_KEY=change-this-in-production

# Rate Limits
USER_MESSAGES_PER_MINUTE=15
USER_MESSAGES_PER_DAY=300
USER_VOICE_PER_DAY=50

# Server
HOST=0.0.0.0
PORT=8001
