# AI service environment variables
# Copy to ai-service/.env. Used both when running directly and in Docker.

# Groq Cloud (OpenAI-compatible API). Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Models
LLM_MODEL=llama-3.3-70b-versatile
LLM_MODEL_FALLBACK=llama-3.1-8b-instant
STT_MODEL=whisper-large-v3-turbo
TTS_MODEL=playai-tts
TTS_VOICE=Fritz-PlayAI

# LLM parameters
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
MAX_CONVERSATION_HISTORY=10
MAX_MEMORY_FACTS=50

# Shared secret between backend and AI service. Must match SERVICE_SECRET_KEY in backend/.env.
SERVICE_SECRET_KEY=put-a-shared-secret-here

# Rate limits
USER_MESSAGES_PER_MINUTE=15
USER_MESSAGES_PER_DAY=300
USER_VOICE_PER_DAY=50
