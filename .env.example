# Kash - Environment Variables

#------------------------------------------------
# Backend
#------------------------------------------------

# Django Backend
DJANGO_SECRET_KEY=64-character-random-string-for-production-use-only
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
POSTGRES_DB=kash_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=database_password_here
# use db when using docker, otherwise use localhost
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Email (Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=email_here
EMAIL_HOST_PASSWORD=email_password_here
DEFAULT_FROM_EMAIL=email_here

# SMS Notifications
SMS_PROVIDER_API_KEY=your-sms-provider-key
SMS_PROVIDER_SENDER=SmartBudget

# Sentry (Error Monitoring)
SENTRY_DSN=

# CORS
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Google OAuth Client IDs
GOOGLE_ANDROID_CLIENT_ID=google-android-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=google-ios-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=google-web-client-id.apps.googleusercontent.com

#------------------------------------------------
# AI Service
#------------------------------------------------

# Groq Cloud (OpenAI-compatible API)
GROQ_API_KEY=llm-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Models
LLM_MODEL=llama-3.3-70b-versatile
LLM_MODEL_FALLBACK=llama-3.1-8b-instant
STT_MODEL=whisper-large-v3-turbo
TTS_MODEL=playai-tts
TTS_VOICE=Fritz-PlayAI

# LLM Parameters
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
MAX_CONVERSATION_HISTORY=10
MAX_MEMORY_FACTS=50

# Service-to-service auth
SERVICE_SECRET_KEY=artha-ai-service-key-change-in-production

# Rate Limits
USER_MESSAGES_PER_MINUTE=15
USER_MESSAGES_PER_DAY=300
USER_VOICE_PER_DAY=50

# Server
HOST=0.0.0.0
PORT=8001

#------------------------------------------------
# Frontend
#------------------------------------------------

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws