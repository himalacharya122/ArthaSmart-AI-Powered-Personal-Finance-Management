# ArthaSmart - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# Django Backend
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
POSTGRES_DB=arthasmart_db
POSTGRES_USER=arthasmart_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# AI / OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o

# Email Notifications
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# SMS Notifications
SMS_PROVIDER_API_KEY=your-sms-provider-key
SMS_PROVIDER_SENDER=SmartBudget

# IoT
IOT_API_KEY_ROTATION_DAYS=30

# MQTT (IoT Communication)
MQTT_BROKER_HOST=mqtt-broker
MQTT_BROKER_PORT=1883
MQTT_USERNAME=iot_user
MQTT_PASSWORD=change_this_mqtt_password

# Sentry (Error Monitoring)
SENTRY_DSN=

# CORS
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws